{
	"name": "modex-cli",
	"version": "0.0.1",
	"description": "Modex CLI - free-first AI coding agent. One CLI. Every model. Free-first coding.",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"modex": "./dist/cli.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsc -p tsconfig.build.json && shx chmod +x dist/cli.js",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"dependencies": {
		"@modex/ai": "^0.0.1",
		"@modex/agent": "^0.0.1",
		"chalk": "6.0.0"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"shx": "0.3.4"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"keywords": [
		"ai",
		"coding-agent",
		"cli",
		"free-first",
		"llm",
		"modex",
		"openrouter",
		"groq",
		"nvidia",
		"cerebras"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/modex-cli/modex.git"
	},
	"homepage": "https://github.com/modex-cli/modex",
	"bugs": {
		"url": "https://github.com/modex-cli/modex/issues"
	},
	"license": "MIT"
}
