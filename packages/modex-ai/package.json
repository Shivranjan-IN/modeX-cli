{
	"name": "@modex/ai",
	"version": "0.0.1",
	"description": "Modex unified LLM API with free-first model routing",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"vitest": "4.1.11",
		"shx": "0.3.4"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
