{
	"name": "modex-cli-monorepo",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"clean": "npm run clean --workspaces",
		"build": "npm run build --workspaces",
		"check": "biome check --write --error-on-warnings . && npm run build",
		"test": "npm run test --workspaces --if-present",
		"generate:free-catalog": "node scripts/generate-free-catalog.ts",
		"version:patch": "npm version patch --workspaces --no-git-tag-version --no-workspaces-update && npm install --package-lock-only --ignore-scripts",
		"version:minor": "npm version minor --workspaces --no-git-tag-version --no-workspaces-update && npm install --package-lock-only --ignore-scripts",
		"version:major": "npm version major --workspaces --no-git-tag-version --no-workspaces-update && npm install --package-lock-only --ignore-scripts",
		"prepublishOnly": "npm run clean && npm run build && npm run check"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/node": "22.19.19",
		"typescript": "7.0.2"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"version": "0.0.1",
	"overrides": {
		"protobufjs": "7.6.6"
	}
}